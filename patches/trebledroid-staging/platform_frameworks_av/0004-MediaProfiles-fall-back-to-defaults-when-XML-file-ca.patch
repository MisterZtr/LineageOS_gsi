From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 10 Apr 2026 12:00:00 +0100
Subject: [PATCH 4/4] MediaProfiles: fall back to defaults when XML file cannot
 be opened

On GSI builds running via DSU, the vendor media_profiles XML file may
exist on disk (passing the stat() check) but be inaccessible due to
SELinux policy mismatches between the GSI system image and the vendor
partition.  The existing code calls CHECK(fopen(...)) which aborts the
process, taking down zygote during CamcorderProfile class preloading
and causing an infinite crash loop that prevents boot.

Replace the fatal CHECK with a graceful NULL return from
createInstanceFromXmlFile, and add a fallback in getInstance that
creates a default MediaProfiles instance when XML parsing fails for
any reason.  This matches the existing fallback path used when no
XML file is found at all.

Bug: none
Change-Id: I0000000000000000000000000000000000000000
---
 media/libmedia/MediaProfiles.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/media/libmedia/MediaProfiles.cpp b/media/libmedia/MediaProfiles.cpp
index 0438806..9caaefe 100644
--- a/media/libmedia/MediaProfiles.cpp
+++ b/media/libmedia/MediaProfiles.cpp
@@ -995,6 +995,11 @@ MediaProfiles::getInstance()
         } else {
             sInstance = createInstanceFromXmlFile(value);
         }
+        if (sInstance == NULL) {
+            ALOGW("Failed to create media profiles from XML. "
+                    "Using the default instance instead.");
+            sInstance = createDefaultInstance();
+        }
         CHECK(sInstance != NULL);
         sInstance->checkAndAddRequiredProfilesIfNecessary();
         sIsInitialized = true;
@@ -1236,8 +1241,11 @@ bool MediaProfiles::checkXmlFile(const char* xmlFile) {
 /*static*/ MediaProfiles*
 MediaProfiles::createInstanceFromXmlFile(const char *xml)
 {
-    FILE *fp = NULL;
-    CHECK((fp = fopen(xml, "r")));
+    FILE *fp = fopen(xml, "r");
+    if (fp == NULL) {
+        ALOGE("failed to open media profiles file '%s'", xml);
+        return NULL;
+    }
 
     XML_Parser parser = ::XML_ParserCreate(NULL);
     CHECK(parser != NULL);
