From 9a8253df64e3af4e59ff6167a6683520a5332724 Mon Sep 17 00:00:00 2001
From: Manikanta Kanamarlapudi <kmanikan@codeaurora.org>
Date: Tue, 24 Mar 2026 13:09:25 +0000
Subject: [PATCH 2/3] libstagefright: Free buffers on observer died

If observer died while allocating buffers, component remains
in loaded state. In cleanup, it checks for idle state to
free the allocated buffers which leads to memory leak.
Hence explicitly calling free buffers to avoid memory leak.

Change-Id: Ia1767c4696dfe32fdcff9dd14d6aa0289fccccc3
---
 media/libstagefright/omx/OMXNodeInstance.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/media/libstagefright/omx/OMXNodeInstance.cpp b/media/libstagefright/omx/OMXNodeInstance.cpp
index 458ac9c..b49b6f7 100644
--- a/media/libstagefright/omx/OMXNodeInstance.cpp
+++ b/media/libstagefright/omx/OMXNodeInstance.cpp
@@ -600,6 +600,11 @@ status_t OMXNodeInstance::freeNode() {
             break;
     }
 
+    // Free any buffers leaked by an observer death during allocation.
+    // freeActiveBuffers() acquires mLock internally, so call before the
+    // outer Autolock to avoid deadlock (mLock is non-recursive).
+    freeActiveBuffers();
+
     Mutex::Autolock _l(mLock);
 
     status_t err = mOwner->freeNode(this);
