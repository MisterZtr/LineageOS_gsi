From 119be878cdaffe8f74680f5be549856b652125cc Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 11 Apr 2026 23:37:17 +0100
Subject: [PATCH 5/5] init: cap SELinux policy version on pre-4.9 kernels to
 avoid xperms rejection

Android sepolicy uses allowxperm / auditallowxperm / dontauditxperm
statements that emit AVTAB_XPERMS_ALLOWED entries in the compiled
policy binary. Kernel ioctl extended-permission (xperms) support was
added upstream in 4.9; Android's 4.4 kernel tree backported it
selectively but many OEM 4.4 forks never picked it up. On those
kernels security_load_policy() fails with -EINVAL and the kernel logs:

  SELinux:  Android master kernel running Android M policy in compatibility mode.
  SELinux: avtab: invalid type or class

init then FATALs and the device reboots to recovery, making the GSI
unbootable on every such device.

xperms were introduced in policydb version 30. When secilc is invoked
with -c 29 (or lower), it silently omits all xperms rules from the
output binary, producing a policy the kernel can load.

Add a KernelOlderThan() helper inside the anonymous namespace (so it
is available to OpenSplitPolicy) and, when the running kernel is
strictly older than 4.9, cap the -c argument to secilc at 29. The
compiled policy is then free of AVTAB_XPERMS entries and loads
successfully.

Modern kernels are completely unaffected: SEPOLICY_VERSION is used
as-is when the kernel is >= 4.9.
---
 init/selinux.cpp | 27 ++++++++++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/init/selinux.cpp b/init/selinux.cpp
index 972efcf..acd3a08 100644
--- a/init/selinux.cpp
+++ b/init/selinux.cpp
@@ -58,6 +58,7 @@
 #include <stdlib.h>
 #include <sys/mount.h>
 #include <sys/wait.h>
+#include <sys/utsname.h>
 #include <unistd.h>
 #include <fcntl.h>
 #include <strings.h>
@@ -233,6 +234,19 @@ struct PolicyFile {
     std::string path;
 };
 
+// Detect kernel major.minor.  Returns true if strictly below the requested
+// version.  Used to cap the policydb version passed to secilc on legacy
+// kernels that lack the ioctl extended-permission (xperms) backport.
+bool KernelOlderThan(unsigned want_major, unsigned want_minor) {
+    struct utsname u;
+    if (uname(&u) != 0) return false;
+    unsigned major = 0, minor = 0;
+    if (sscanf(u.release, "%u.%u", &major, &minor) != 2) return false;
+    if (major < want_major) return true;
+    if (major == want_major && minor < want_minor) return true;
+    return false;
+}
+
 bool OpenSplitPolicy(PolicyFile* policy_file) {
     // IMPLEMENTATION NOTE: Split policy consists of three or more CIL files:
     // * platform -- policy needed due to logic contained in the system image,
@@ -335,7 +349,18 @@ bool OpenSplitPolicy(PolicyFile* policy_file) {
     if (access(odm_policy_cil_file.c_str(), F_OK) == -1) {
         odm_policy_cil_file.clear();
     }
-    const std::string version_as_string = std::to_string(SEPOLICY_VERSION);
+    // Kernels older than 4.9 may lack the ioctl extended-permission (xperms)
+    // backport.  Policies compiled at policydb version >= 30 contain
+    // AVTAB_XPERMS_ALLOWED entries that such kernels cannot parse, causing
+    // security_load_policy() to fail with EINVAL.  Cap the version to 29 so
+    // secilc omits xperms rules.
+    unsigned int effective_version = SEPOLICY_VERSION;
+    if (KernelOlderThan(4, 9) && effective_version > 29) {
+        LOG(WARNING) << "SELinux: capping policy version from " << effective_version
+                     << " to 29 for legacy kernel (no xperms support)";
+        effective_version = 29;
+    }
+    const std::string version_as_string = std::to_string(effective_version);
 
     std::vector<std::string> genfs_cil_files;
 
-- 
