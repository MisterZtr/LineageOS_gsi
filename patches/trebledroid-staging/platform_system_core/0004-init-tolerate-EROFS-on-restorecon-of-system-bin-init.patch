From 01fa5be037a44e5cec35cd8c067e271d419aa7d7 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 19 Mar 2026 07:03:19 +0000
Subject: [PATCH 4/8] init: tolerate EROFS on restorecon of /system/bin/init

On devices with kernel <= 4.14, the system partition is ext4 but the
kernel implicitly advertises seclabel support regardless of the fstab
mount options.  libselinux therefore does not exclude /system from
relabelling, but /system is mounted read-only, so lsetfilecon returns
EROFS even when the existing label on /system/bin/init is already
correct and no write is actually needed.

Android 15+ init treats any restorecon failure here as fatal, causing
an InitFatalReboot into recovery that loops indefinitely.  The label
in the GSI image is correct (u:object_r:init_exec:s0), so there is no
actual mislabelling to fix -- the write is simply unnecessary.

Tolerate EROFS specifically: if lgetfilecon succeeds we log a warning
and continue; if lgetfilecon also fails we still fatal as before.
---
 init/selinux.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/init/selinux.cpp b/init/selinux.cpp
index 951dc38..972efcf 100644
--- a/init/selinux.cpp
+++ b/init/selinux.cpp
@@ -878,8 +878,25 @@ int SetupSelinux(char** argv) {
     // store SELabels in their xattrs, such as ext4 do not need an explicit restorecon here,
     // but other file systems do.  In particular, this is needed for ramdisks such as the
     // recovery image for A/B devices.
+    //
+    // On legacy devices (kernel <= 4.14) the system partition is ext4 but the kernel implicitly
+    // advertises seclabel support, so libselinux does not exclude /system from relabelling.
+    // However /system is mounted read-only, causing lsetfilecon to fail with EROFS even when the
+    // existing label is already correct.  Treat EROFS as non-fatal when the label already matches
+    // the expected value -- the file is correctly labelled and no write is needed.
     if (selinux_android_restorecon("/system/bin/init", 0) == -1) {
-        PLOG(FATAL) << "restorecon failed of /system/bin/init failed";
+        if (errno == EROFS) {
+            char* ctx = nullptr;
+            if (lgetfilecon("/system/bin/init", &ctx) >= 0) {
+                LOG(WARNING) << "restorecon of /system/bin/init failed with EROFS but label is '"
+                             << ctx << "' -- continuing on read-only fs";
+                freecon(ctx);
+            } else {
+                PLOG(FATAL) << "restorecon failed of /system/bin/init failed";
+            }
+        } else {
+            PLOG(FATAL) << "restorecon failed of /system/bin/init failed";
+        }
     }

     setenv(kEnvSelinuxStartedAt, std::to_string(start_time.time_since_epoch().count()).c_str(), 1);
-- 
