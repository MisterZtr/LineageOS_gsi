From c5ea3d4fc5cbda218cc5d9aeafc2d26fb31356dc Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 25 Apr 2026 00:00:00 +0100
Subject: [PATCH 2/2] Harden OPPO/Realme root detection bypass with
 warranty_bit and service stop

The existing OPPO/Realme bypass (patch 0023) only sets
ro.boot.flash.locked, ro.boot.vbmeta.device_state and
ro.boot.verifiedbootstate. However, on devices like the RMX2040
(Realme 6), the oppo_root_check logic also checks warranty_bit
properties and sys.oem_unlock_allowed before deciding to reboot to
recovery.

Extend the bypass to also spoof:
- ro.boot.warranty_bit=0
- ro.vendor.warranty_bit=0
- ro.warranty_bit=0
- sys.oem_unlock_allowed=0

And attempt to stop the oppo_root_check vendor init service by
setting ctl.stop, preventing it from executing its reboot-to-recovery
logic on devices where it runs as an init service.

Note: if the device's kernel module reads hardware eFUSES directly
(rather than checking properties), no property spoofing will help.
This is a fundamental hardware limitation.

Fixes: #38
---
 rw-system.sh | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index e13f397..e295b70 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -812,6 +812,12 @@ if [ "$brand" = OPPO ] || [ "$brand" = realme ]; then
     resetprop_phh ro.boot.flash.locked 1
     resetprop_phh ro.boot.vbmeta.device_state locked
     resetprop_phh ro.boot.verifiedbootstate green
+    resetprop_phh ro.boot.warranty_bit 0
+    resetprop_phh ro.vendor.warranty_bit 0
+    resetprop_phh ro.warranty_bit 0
+    resetprop_phh -n sys.oem_unlock_allowed 0
+    # Stop the vendor root check service if it exists as an init service
+    setprop ctl.stop oppo_root_check 2>/dev/null
 fi
 
 if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
