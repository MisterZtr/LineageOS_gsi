From 6c570128cd9e64642d09c6212659fa7a30a13442 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 22 Apr 2026 18:11:15 +0100
Subject: [PATCH 23/25] Block OPPO/Realme root detection reboot on GSI boot

OPPO and Realme devices with MediaTek vendor kernels include an
oppo_root_check kernel module that detects an unlocked bootloader
and forces a reboot to recovery. This makes the GSI completely
unbootable on these devices.

Set ro.boot.flash.locked, ro.boot.vbmeta.device_state and
ro.boot.verifiedbootstate to locked/green in rw-system.sh during
on post-fs, before vendor init services run. Use
ro.product.vendor.brand (not ro.product.brand) to detect the
device because the GSI system image overrides ro.product.brand
early in boot, before any init property triggers can fire.

Note: this may not prevent the kernel-level fuse check on all
devices; additional handling may be needed for full coverage on
devices where the kernel module reads fuses directly.
---
 rw-system.sh | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/rw-system.sh b/rw-system.sh
index b487c60..086e147 100644
--- a/rw-system.sh
+++ b/rw-system.sh
@@ -800,6 +800,20 @@ copyprop() {
         resetprop_phh "$1" "$(getprop "$2")"
     fi
 }
+
+# OPPO/Realme devices with MTK vendor kernels include an oppo_root_check
+# kernel module that detects an unlocked bootloader and forces a reboot to
+# recovery.  set the boot-state properties to "locked" so any userspace
+# component of the check sees a locked device.  use ro.product.vendor.brand
+# (not ro.product.brand) because the GSI system image overrides
+# ro.product.brand early in boot, before this script runs.
+brand="$(getprop ro.product.vendor.brand)"
+if [ "$brand" = OPPO ] || [ "$brand" = realme ]; then
+    resetprop_phh ro.boot.flash.locked 1
+    resetprop_phh ro.boot.vbmeta.device_state locked
+    resetprop_phh ro.boot.verifiedbootstate green
+fi
+
 if [ -f /system/phh/secure ] || [ -f /metadata/phh/secure ];then
     copyprop ro.build.device ro.vendor.build.device
     copyprop ro.system.build.fingerprint ro.vendor.build.fingerprint
-- 
