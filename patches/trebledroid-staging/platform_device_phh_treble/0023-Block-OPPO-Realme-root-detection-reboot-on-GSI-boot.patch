From 6c271ded6c0282b1af47ee5f38dc5833698dd891 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 21 Apr 2026 18:06:44 +0100
Subject: [PATCH 23/23] Block OPPO/Realme root detection reboot on GSI boot

OPPO and Realme devices with MediaTek vendor kernels include an
oppo_root_check kernel module that detects an unlocked bootloader
and forces a reboot to recovery. This makes the GSI completely
unbootable on these devices.

Add on property:ro.product.brand=OPPO and on property:ro.product.brand=realme
init triggers that set ro.boot.flash.locked=1, ro.boot.vbmeta.device_state=locked,
and ro.boot.verifiedbootstate=green when the device brand property matches.

Note: this may not prevent the kernel-level fuse check on all devices;
additional kernel module handling may be needed for full coverage on devices
where the kernel module reads fuses directly.
---
 vndk.rc | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/vndk.rc b/vndk.rc
index 2bd6b35..1a375f6 100644
--- a/vndk.rc
+++ b/vndk.rc
@@ -6,6 +6,21 @@ on post-fs
 
     start watchdogd-gsi
 
+on property:ro.product.brand=OPPO
+    # OPPO devices with MTK vendor kernels include an oppo_root_check kernel
+    # module that detects an unlocked bootloader and forces a reboot to recovery.
+    # Set the boot-state properties to "locked" so any userspace component of
+    # the check sees a locked device.
+    setprop ro.boot.flash.locked 1
+    setprop ro.boot.vbmeta.device_state locked
+    setprop ro.boot.verifiedbootstate green
+
+on property:ro.product.brand=realme
+    # Same as above for realme (shared MTK kernel modules with OPPO)
+    setprop ro.boot.flash.locked 1
+    setprop ro.boot.vbmeta.device_state locked
+    setprop ro.boot.verifiedbootstate green
+
 on property:vold.decrypt=trigger_restart_framework
     exec - root -- /system/bin/phh-on-data.sh
 
@@ -135,4 +150,4 @@ service watchdogd-gsi /system/bin/watchdogd 10 20
 
 on property:persist.sys.phh.adb_secure=1
     exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.adb.secure 1
-    restart adbd
+    restart adbd
\ No newline at end of file
