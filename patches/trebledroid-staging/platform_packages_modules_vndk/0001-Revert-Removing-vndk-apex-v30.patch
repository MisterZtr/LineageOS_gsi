From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christopher A. Williamson <contact@chrisaw.io>
Date: Tue, 04 Feb 2026 00:00:00 +0000
Subject: [PATCH] Revert "Removing vndk apex v30"

VNDK v30 was removed in A16 QPR2, restore it for GSI compatibility.
---
 apex/Android.bp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/apex/Android.bp b/apex/Android.bp
index baf8d19..ca076b8 100644
--- a/apex/Android.bp
+++ b/apex/Android.bp
@@ -63,6 +63,13 @@ apex_vndk {
     vndk_version: "31",
     system_ext_specific: true,
 }
+
+apex_vndk {
+    name: "com.android.vndk.v30",
+    defaults: ["vndk-apex-defaults"],
+    vndk_version: "30",
+    system_ext_specific: true,
+}

 apex_vndk {
     name: "com.android.vndk.v29",
-- 
