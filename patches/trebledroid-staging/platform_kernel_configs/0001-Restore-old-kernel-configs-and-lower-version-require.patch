@@ -0,0 +1,144 @@
+<kernel minlts="4.9.141" />
+
+<!-- KEEP ALPHABETICALLY SORTED -->
+<!-- ARM base requirements -->
+<group>
+	<conditions>
+		<config>
+			<key>CONFIG_ARM</key>
+			<value type="bool">y</value>
