From 47041ee473b5d7b1ddeee96963cad3c6f6176c40 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 17 Mar 2026 23:18:19 +0000
Subject: [PATCH 2/6] ClatCoordinator: make CLAT permission checks non-fatal for
 GSI

Make BPF obj_get failures in ClatCoordinator non-fatal (ALOGE instead
of ALOGF + abort) and unconditionally skip CLAT permission verification
on pre-5.10 kernels. The isGsiImage() guard is removed so the
relaxation applies to all GSI-compatible devices, not just official
GSI builds.

On older kernels where BPF programs may not have loaded correctly, the
CLAT permission check would abort the connectivity service, breaking
all networking. With this change, CLAT (IPv4-over-IPv6 translation)
may not function on affected devices, but all other connectivity
continues to work.
---
 ...droid_server_connectivity_ClatCoordinator.cpp | 16 ++++------------
 1 file changed, 4 insertions(+), 12 deletions(-)

diff --git a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
index 437e78f..01a0c2f 100644
--- a/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
+++ b/service/jni/com_android_server_connectivity_ClatCoordinator.cpp
@@ -84,18 +84,13 @@ static void verifyPerms(const char * const path,
       case VERIFY_MAP_RW: fd = bpf::mapRetrieveLocklessRW(path); break;
     }

-    if (fd < 0) ALOGF("bpf_obj_get '%s' failed, errno=%d", path, errno);
+    if (fd < 0) ALOGE("bpf_obj_get '%s' failed, errno=%d", path, errno);

     if (fd >= 0) close(fd);
 }

 #undef ALOGF

-bool isGsiImage() {
-    // this implementation matches 2 other places in the codebase (same function name too)
-    return !access("/system/system_ext/etc/init/init.gsi.rc", F_OK);
-}
-
 static const char* kClatdDir = "/apex/com.android.tethering/bin/for-system";
 static const char* kClatdBin = "/apex/com.android.tethering/bin/for-system/clatd";

@@ -138,14 +133,11 @@ static void verifyClatPerms() {
 #undef V2

     // HACK: Some old vendor kernels lack ~5.10 backport of 'bpffs selinux genfscon' support.
-    // This is *NOT* supported, but let's allow, at least for now, U+ GSI to boot on them.
-    // (without this hack pixel5 R vendor + U gsi breaks)
-    if (isGsiImage() && !bpf::isAtLeastKernelVersion(5, 10, 0)) {
-        ALOGE("GSI with *BAD* pre-5.10 kernel lacking bpffs selinux genfscon support.");
+    // This is *NOT* supported, but let's allow, at least for now, to make 16 QPR2 boot on them.
+    if (!bpf::isAtLeastKernelVersion(5, 10, 0)) {
+        ALOGW("Kernel < 5.10 detected, skipping CLAT perms for legacy kernel.");
         return;
     }
-
-    if (fatal) abort();
 }

 #undef V
