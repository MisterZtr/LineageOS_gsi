From 02bfc9926999213cf20d806bdfc9eeb322d6a5e1 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 24 Mar 2026 12:44:06 +0000
Subject: [PATCH 08/11] remove persist.sys.usb.config=adb default from base.mk

adb is disabled by default on release builds; enabling it requires
the usual developer options + usb debugging toggle. debug builds
re-enable it via the debug tier.
---
 base.mk | 1 -
 1 file changed, 1 deletion(-)

diff --git a/base.mk b/base.mk
index 439bef8..abcfd3f 100644
--- a/base.mk
+++ b/base.mk
@@ -38,7 +38,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    persist.sys.usb.config=adb \
     ro.cust.cdrom=/dev/null
 
 # VNDK config files
-- 
