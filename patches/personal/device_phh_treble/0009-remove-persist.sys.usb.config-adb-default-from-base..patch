From 8f94baf5e261e9bb5562f4499b4ace5136d6881d Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Tue, 24 Mar 2026 12:44:06 +0000
Subject: [PATCH 2/3] remove persist.sys.usb.config=adb default from base.mk

adb is disabled by default on release builds; enabling it requires
the usual developer options + usb debugging toggle. debug builds
re-enable it via the debug tier.
---
 base.mk | 1 -
 1 file changed, 1 deletion(-)

diff --git a/base.mk b/base.mk
index 4bc643c..414347e 100644
--- a/base.mk
+++ b/base.mk
@@ -43,7 +43,6 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 
 # Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
-    persist.sys.usb.config=adb \
     ro.cust.cdrom=/dev/null
 
 # VNDK config files
-- 
2.53.0

