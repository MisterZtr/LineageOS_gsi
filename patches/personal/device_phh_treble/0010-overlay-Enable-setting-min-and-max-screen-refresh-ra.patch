From af66ce3c1b0a2e548dc5622fd40c3c81bd754ede Mon Sep 17 00:00:00 2001
From: MisterZtr <andey2004586@gmail.com>
Date: Mon, 4 May 2026 07:50:42 +0300
Subject: [PATCH 10/10] overlay: Enable setting min and max screen refresh
 rates

---
 .../apps/Settings/res/values/lineage_config.xml      | 12 ++++++++++++
 1 file changed, 12 insertions(+)
 create mode 100644 overlay/packages/apps/Settings/res/values/lineage_config.xml

diff --git a/overlay/packages/apps/Settings/res/values/lineage_config.xml b/overlay/packages/apps/Settings/res/values/lineage_config.xml
new file mode 100644
index 0000000..e3d37dc
--- /dev/null
+++ b/overlay/packages/apps/Settings/res/values/lineage_config.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+SPDX-FileCopyrightText: The LineageOS Project
+SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Whether to show peak refresh rate in display settings -->
+    <bool name="config_show_peak_refresh_rate_switch">true</bool>
+
+    <!-- Whether to show min refresh rate in display settings -->
+    <bool name="config_show_min_refresh_rate_switch">true</bool>
+</resources>
-- 
2.54.0

