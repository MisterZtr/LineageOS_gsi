From 0a001592f24cea32643e4417fc4e8e567b7dff0d Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 20 Apr 2026 17:30:09 +0100
Subject: [PATCH 2/2] sepolicy: allow crash_dump to ptrace init for GSI tombstone
 capture

On GSI devices, init may crash with SIGSEGV due to vendor
incompatibilities (e.g. Samsung Exynos vendor init). Without
ptrace access, crash_dump64 is denied by SELinux and cannot
capture tombstones, making diagnosis of the crash impossible.

Remove init from the crash_dump ptrace exclusion list and
neverallow assertion. Add explicit allow rules for crash_dump
to ptrace init and read init's executable for symbol resolution.

This is safe because crash_dump has no persistent state and only
runs in response to a crash.
---
 private/crash_dump.te | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/private/crash_dump.te b/private/crash_dump.te
index 4bd1d38..0b8eadc 100644
--- a/private/crash_dump.te
+++ b/private/crash_dump.te
@@ -8,7 +8,7 @@ allow crash_dump {
   -apexd
   -bpfloader
   -crash_dump
-  -init
+  # -init removed: allow crash_dump to ptrace init for GSI tombstone capture
   -kernel
   -keystore
   -llkd
@@ -18,6 +18,14 @@ allow crash_dump {
   -vold
 }:process { ptrace signal sigchld sigstop sigkill };
 
+# Allow crash_dump to ptrace init on GSI builds.
+# On GSI devices, init may crash with SIGSEGV due to vendor incompatibilities.
+# Without ptrace access, tombstones cannot be captured, making diagnosis
+# impossible. This is safe because crash_dump has no persistent state and
+# only runs in response to a crash.
+allow crash_dump init:process ptrace;
+allow crash_dump init:file { read open getattr };
+
 userdebug_or_eng(`
   allow crash_dump { apexd llkd logd vold }:process { ptrace signal sigchld sigstop sigkill };
 ')
@@ -129,7 +137,7 @@ neverallow crash_dump {
   apexd
   userdebug_or_eng(`-apexd')
   bpfloader
-  init
+  # init removed from neverallow: crash_dump needs ptrace on GSI for tombstone capture
   kernel
   keystore
   llkd
